# Copy to .env in the project root (PFE-Obstacle-Detection/.env), then restart the server.
# PowerShell:  $env:GROQ_API_KEY="gsk_xxx"
# macOS/Linux: export GROQ_API_KEY=gsk_xxx

# Required for scene describe + navigation voice (get a free key at https://console.groq.com)
GROQ_API_KEY=
ENABLE_GROQ=1
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MIN_INTERVAL_S=4.0
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONF=0.2
YOLO_IMGSZ=640

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Local MoonDream2 captioning (used for /predict description)
MOONDREAM_MODEL_ID=vikhyatk/moondream2
MOONDREAM_QUESTION=What obstacles are ahead?
# backend: auto (prefer MLX), mlx (force), transformers (force torch/transformers)
MOONDREAM_BACKEND=auto
# 0.25–0.5 = more factual; higher = more varied wording
GEMINI_TEMPERATURE=0.35
GEMINI_MAX_OUTPUT_TOKENS=768
# 1 = JSON advice (advice_en, advice_darija, risk, focus_object); 0 = prose only
GEMINI_STRUCTURED_OUTPUT=1
# Optional: override the system instruction (long string)
# GEMINI_SYSTEM_INSTRUCTION=
# Horizontal camera FOV in degrees (phone main cam ~60–70). Wrong FOV = wrong distance.
CAMERA_HORIZONTAL_FOV_DEG=64
# If distances are always too high, try 0.75–0.9; too low, try 1.1–1.3
DEPTH_GLOBAL_SCALE=1.0
# YOLO dual models — outdoor + indoor (merged at /predict)
YOLO_WEIGHTS=
YOLO_WEIGHTS_INDOOR=
YOLO_CONF=0.40
YOLO_IMGSZ=640
# fast = outdoor every frame + indoor every 2nd (smooth, ~1s/frame)
# auto = both models every frame (accurate, ~2.5s/frame)
YOLO_ROUTE=fast
YOLO_INDOOR_EVERY_N=2
YOLO_MAX_LONG_EDGE=1280
# ENABLE_SCENE_MODEL=0  -> skip ResNet scene head
# Optional: paste your thesis "rule" text (e.g. distance policy) for Gemini
# GEMINI_EXTRA_RULES=
